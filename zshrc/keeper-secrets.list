# Keeper-backed environment variables, loaded by conf.d/99-secrets.zsh.
#
# Each line: VAR_NAME [search tags...]
# The Keeper record is titled env:global:VAR_NAME; the secret is its password field.
# Add entries with `secrets-add VAR_NAME [tags...]`, or edit this file directly.
#
# "ignore VAR_NAME" marks an env:global:* record in Keeper that you don't want
# loaded; it stops the "not in keeper-secrets.list" notice for that record.

ELEVEN_LABS_API_KEY      elevenlabs eleven labs audio
OPENROUTER_API_KEY       openrouter llm ai
POCKETSMITH_API_KEY      pocketsmith finance
TYPESAFE_API_KEY         typesafe judge
OPUS55_AZURE_ENDPOINT    opus55 opus azure anthropic claude
OPUS55_AZURE_API_KEY     opus55 opus azure anthropic claude
OPUS55_AZURE_DEPLOYMENT  opus55 opus azure anthropic claude
AZURE_DEVOPS_EXT_PAT azure devops

